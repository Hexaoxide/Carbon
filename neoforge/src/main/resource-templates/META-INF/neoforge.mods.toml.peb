modLoader = "javafml"
loaderVersion = "[1,)"
license = "GPLv3"
issueTrackerURL = "{{ githubUrl }}/issues"
showAsResourcePack = false

[[mods]]
modId = "carbonchat"
version = "{{ version }}"
displayName = "CarbonChat"
displayURL = "{{ githubUrl }}"
authors = ["Draycia", "jmp"]
description = "{{ description }}"
displayTest = "IGNORE_ALL_VERSION"

[[dependencies.carbonchat]]
modId = "neoforge"
type = "required"
versionRange = "[21.0,)"
ordering = "NONE"
side = "BOTH"

[[dependencies.carbonchat]]
modId = "minecraft"
type = "required"
versionRange = "[1.21.1]"
ordering = "NONE"
side = "BOTH"

[[mixins]]
config = "carbonchat-mod-common.mixins.json"

[[mixins]]
config = "carbonchat-neoforge.mixins.json"
