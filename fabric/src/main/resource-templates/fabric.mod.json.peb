{
    "schemaVersion": 1,
    "id": "{{ modId }}",
    "version": "{{ version }}",
    "name": "{{ name }}",
    "description": "{{ description }}",
    "authors": [
        "Draycia",
        "jmp"
    ],
    "contact": {
        "homepage": "{{ githubUrl }}",
        "sources": "{{ githubUrl }}",
        "issues": "{{ githubUrl }}/issues"
    },
    "license": "GPLv3",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.draycia.carbon.fabric.CarbonFabricBootstrap"
        ]
    },
    "mixins": [
        "carbonchat.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.5",
        "fabric": "*",
        "cloud": "*",
        "adventure-platform-fabric": "*",
        "minecraft": ">=1.21 <=1.21.1",
        "luckperms": ">=5.0.0"
    },
    "suggests": {
        "miniplaceholders": "*"
    }
}
